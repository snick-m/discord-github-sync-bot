# Credentials and repository-to-forum mappings are now configured in the web UI.
# This file may be left empty. Defaults start the dashboard and private setup page.

# Public application origin (required when accessing through a public hostname).
PUBLIC_URL=http://localhost:5000
PORT=5000
# First-administrator setup is served ONLY on 127.0.0.1 at this port.
SETUP_PORT=5001
DATA_DIR=data
RECONCILE_SECONDS=300

# Optional R2 attachment preservation: set all four or leave all empty.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=
R2_CDN_BASE_URL=

# Existing single-repository environment settings are imported on first startup.
# New installations should enter Discord/GitHub tokens in the management UI.
