# Required: Discord bot token and the forum channel ID (not a text channel).
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=

# Required: fine-grained GitHub PAT with Issues: read/write on ONE repository.
GITHUB_ACCESS_TOKEN=
GITHUB_USERNAME=
GITHUB_REPOSITORY=

# Required: choose a random secret and use the same value in GitHub's webhook settings.
GITHUB_WEBHOOK_SECRET=

# Optional: comma-separated Discord role IDs allowed to close/reopen issues.
# Members with Manage Threads in the forum are always allowed.
MANAGER_ROLE_IDS=

# Optional: host port; Docker always uses 5000 internally. Published to localhost only.
PORT=5000
# Local Node deployment only. Docker stores SQLite in the bot-data volume.
DATA_DIR=data
RECONCILE_SECONDS=300
# none = new items from the first start onward; open = also import existing open
# GitHub issues and active human-created Discord posts. Use a dedicated forum.
BACKFILL=none

# Optional: set ALL four to preserve Discord attachments in your own R2 bucket.
# Without R2, attachment links copied to GitHub can expire.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=
R2_CDN_BASE_URL=
