{
  "name": "discord-github-sync-bot",
  "version": "1.1.0",
  "description": "Bidirectional sync between Discord forum threads and GitHub issues",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src README.md",
    "queue": "node dist/queue.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "author": "Austin Melchior (Sillhouette)",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^20.1.2",
    "discord.js": "^14.28.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@8.6.3"
}
